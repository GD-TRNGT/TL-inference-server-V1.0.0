# One independent FLUX.3 Klein worker on a Blackhole Galaxy.
#
# TT_VISIBLE_DEVICES selects one of the four 8-chip column Rings; this
# descriptor gives that logical mesh its Ring collective semantics.  It has
# no device-id binding, so the same descriptor is used by every worker.
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 8, 1 ] dim_types: [ RING, LINE ] }
  host_topology { dims: [ 1, 1 ] }
  channels { count: 2 policy: STRICT }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
