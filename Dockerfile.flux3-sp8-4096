# Persist the Galaxy03-tested FLUX.3 media service on the validated v1.0.6 TT-Metal runtime.
# This image versions the server layer without copying an uncommitted TT-Metal worktree.
FROM galaxy-inference-media-server:flux-3-image-klein-tl-v1.0.6

USER root
COPY --chown=container_app_user:container_app_user tt-media-server/ /home/container_app_user/tt-metal/server/
RUN chmod +x /home/container_app_user/tt-metal/server/run_uvicorn.sh
